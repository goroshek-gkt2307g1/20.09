<Window x:Class="_20._09.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20._09"
        mc:Ignorable="d"
        Title="Main" Height="450" Width="800">
    <Grid>
        <Canvas x:Name="MainCanvas">
            <Button x:Name="runButton" Width="140" Height="60" 
                    Content="run" Canvas.Left="100" Canvas.Top="100"
                    MouseEnter="RunButton">

                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                    x:Name="leftAnimation"
                                    Storyboard.TargetProperty="(Canvas.Left)"
                                    Duration="0:0:0.3" 
                                    FillBehavior="HoldEnd"/>
                                
                                <DoubleAnimation 
                                    x:Name="topAnimation"
                                    Storyboard.TargetProperty="(Canvas.Top)"
                                    Duration="0:0:0.3"
                                    FillBehavior="HoldEnd"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>

            <Ellipse Name="Pulsar" Width="200" Height="200"
                     Canvas.Left="130" Canvas.Bottom="0">
                <Ellipse.Fill>
                    <RadialGradientBrush RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5, 0.5">
                        <GradientStop Color="Red" Offset="0"/>
                        <GradientStop Color="Yellow" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
				<Ellipse.Triggers>
					<EventTrigger RoutedEvent="Window.Loaded">
						<BeginStoryboard>
							<Storyboard>
								<ColorAnimation Storyboard.TargetProperty="Fill.GradientStops[1].Color"
										To="Red" Duration="0:0:1" AutoReverse="True"
										RepeatBehavior="Forever" />
							</Storyboard>
						</BeginStoryboard>
					</EventTrigger>
				</Ellipse.Triggers>
            </Ellipse>
        </Canvas>
    </Grid>
</Window>